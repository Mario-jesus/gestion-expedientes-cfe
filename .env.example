# Copia este archivo a .env.development o .env.production y ajusta los valores

# Ambiente
VITE_APP_ENV=development

# URL base del API (ajusta según tu backend)
VITE_API_BASE_URL=http://localhost:3000/api

# Información de la aplicación
VITE_APP_NAME=Sistema de Gestión de Expedientes CFE
VITE_APP_VERSION=1.0.0

# Configuraciones opcionales
VITE_ENABLE_LOGGER=true
VITE_MIN_LOG_LEVEL=debug

VITE_ENABLE_MOCK_API=false
